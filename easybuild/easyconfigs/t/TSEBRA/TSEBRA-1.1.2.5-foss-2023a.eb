easyblock = 'Tarball'

name = 'TSEBRA'
version = '1.1.2.5'

homepage = 'https://github.com/Gaius-Augustus/TSEBRA'

description = """
TSEBRA is a combiner tool that selects transcripts from gene predictions based
on the support by extrisic evidence in form of introns and start/stop codons.
It was developed to combine BRAKER1 and BRAKER2 predicitons to increase their
accuracies.
"""

toolchain = {'name': 'foss', 'version': '2023a'}

dependencies = [
    ('compleasm', '0.2.5'),
]

source_urls = ['https://github.com/Gaius-Augustus/%(name)s/archive/refs/tags']
sources = ['v%(version)s.tar.gz']
patches = ['%(name)s-%(version)s_change_compleasm_call.patch']


sanity_check_paths = {
    'files': ['bin/tsebra.py'],
    'dirs': ['bin', 'config']
}

moduleclass = 'bio'
