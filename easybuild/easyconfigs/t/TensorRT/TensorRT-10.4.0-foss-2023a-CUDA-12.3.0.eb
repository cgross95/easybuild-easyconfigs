name = 'TensorRT'
version = "10.4.0"
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://developer.nvidia.com/tensorrt'
description = "NVIDIA TensorRT is a platform for high-performance deep learning inference"

toolchain = {'name': 'foss', 'version': '2023a'}

sources = ['%(name)s-%(version)s.26.Linux.%(arch)s-gnu.cuda-12.6.tar.gz']
checksums = []
builddependencies = [
    ('protobuf', '24.0'),
]
dependencies = [
    ('Python', '3.11.3'),
    ('SciPy-bundle', '2023.07'),
    ('CUDA', '12.3.0', '', SYSTEM),
    ('cuDNN', '8.9.7.29', '-CUDA-%(cudaver)s', SYSTEM),
    ('protobuf-python', '4.24.0'),
]

download_instructions = "Manual download from https://developer.nvidia.com/nvidia-%(namelower)s-8x-download "

moduleclass = 'lib'
