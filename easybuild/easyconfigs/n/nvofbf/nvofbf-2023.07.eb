easyblock = 'Toolchain'

name = 'nvofbf'
version = '2023.07'

homepage = '(none)'
description = """NVHPC based toolchain, including OpenMPI for MPI support,
OpenBLAS (via FlexiBLAS for BLAS and LAPACK support), FFTW and ScaLAPACK."""

toolchain = {'name': 'system', 'version': '2023.07'}

dependencies = [
    ('NVHPC', '23.7-CUDA-12.1.1'),
    ('OpenMPI', '4.1.5', '', ('NVHPC', '23.7-CUDA-12.1.1')),
    ('FlexiBLAS', '3.3.1', '', ('NVHPC', '23.7-CUDA-12.1.1')),
    ('FFTW', '3.3.10', '', ('NVHPC', '23.7-CUDA-12.1.1')),
    ('FFTW.MPI', '3.3.10', '', ('nvompi', '2023.07')),
    ('ScaLAPACK', '2.2.0', '-fb', ('nvompi', '2023.07')),
]


moduleclass = 'toolchain'
