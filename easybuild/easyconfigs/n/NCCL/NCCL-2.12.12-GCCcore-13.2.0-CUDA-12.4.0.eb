name = 'NCCL'
version = '2.12.12'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://developer.nvidia.com/nccl'
description = """The NVIDIA Collective Communications Library (NCCL) implements multi-GPU and multi-node collective
communication primitives that are performance optimized for NVIDIA GPUs."""

toolchain = {'name': 'GCCcore', 'version': '13.2.0'}

source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s-1.tar.gz']
patches = ['%(name)s-2.16.2_fix-cpuid.patch']
checksums = [
    {'v2.12.12-1.tar.gz': '49b4fbfeebf1f62f6ceb69e72504045d8d1b4e7609e3c2477906f3004c7e2d82'},
    {'%(name)s-2.16.2_fix-cpuid.patch': '0459ecadcd32b2a7a000a2ce4f675afba908b2c0afabafde585330ff4f83e277'},
]

builddependencies = [
    ('binutils', '2.40'),
]
dependencies = [
    ('CUDA', '12.4.0', '', SYSTEM),
    ('UCX-CUDA', '1.18.0', '-CUDA-%(cudaver)s'),
]

github_account = 'NVIDIA'

moduleclass = 'lib'
