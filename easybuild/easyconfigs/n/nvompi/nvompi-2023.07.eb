easyblock = 'Toolchain'

name = 'nvompi'
version = '2023.07'

homepage = '(none)'
description = 'NVHPC based compiler toolchain, including OpenMPI for MPI support.'

toolchain = SYSTEM

local_compiler = ('NVHPC', '23.7-CUDA-12.1.1')

dependencies = [
    local_compiler,
    ('OpenMPI', '4.1.5', '', local_compiler),
    ('CUDA', '12.1.1', '', SYSTEM),
]

moduleclass = 'toolchain'
