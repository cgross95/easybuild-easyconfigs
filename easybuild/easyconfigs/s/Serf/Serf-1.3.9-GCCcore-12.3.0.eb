easyblock = 'SCons'

name = 'Serf'
version = '1.3.9'

homepage = 'https://serf.apache.org/'
description = """The serf library is a high performance C-based HTTP client library
 built upon the Apache Portable Runtime (APR) library"""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

source_urls = [APACHE_SOURCE]
sources = [SOURCELOWER_TAR_BZ2]
patches = [
    '%(name)s-%(version)s_python3_scons.patch',
    '%(name)s-%(version)s_sslbuckets.patch',
]
checksums = [
    '549c2d21c577a8a9c0450facb5cca809f26591f048e466552240947bdf7a87cc',  # %(namelower)s-%(version)s.tar.bz2
    'db401893bfb464ddcf369b543cacb9a165a21f8ff9bf1a819e4b61550bb9d3d0',  # %(name)s-%(version_major_minor)s.9_python3_scons.patch
]

builddependencies = [
    ('binutils', '2.40'),
    ('Python', '3.11.3'),
    ('SCons', '4.5.2'),
]
dependencies = [
    ('APR', '1.7.4'),
    ('APR-util', '1.6.3'),
    ('OpenSSL', '1.1', '', SYSTEM),
]

buildopts = "APR=$EBROOTAPR/bin/apr-1-config APU=$EBROOTAPRMINUTIL/bin/apu-1-config"


sanity_check_paths = {
    'files': ['include/%(namelower)s-1/%(namelower)s.h', 'lib/libserf-1.a', 'lib/libserf-1.so'],
    'dirs': [],
}

moduleclass = 'tools'
