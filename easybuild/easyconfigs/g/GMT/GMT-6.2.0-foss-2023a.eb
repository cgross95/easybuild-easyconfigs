easyblock = 'CMakeMake'

name = 'GMT'
version = '6.2.0'

homepage = 'https://www.generic-mapping-tools.org/'
description = """GMT is an open source collection of about 80 command-line tools for manipulating
 geographic and Cartesian data sets (including filtering, trend fitting, gridding, projecting,
 etc.) and producing PostScript illustrations ranging from simple x-y plots via contour maps
 to artificially illuminated surfaces and 3D perspective views; the GMT supplements add another
 40 more specialized and discipline-specific tools. """

toolchain = {'name': 'foss', 'version': '2023a'}

# 'https://gmt.soest.hawaii.edu/files/download?name=' needs browser with javascript magic
source_urls = [
    'ftp://ftp.soest.hawaii.edu/%(namelower)s',
    'ftp://ftp.soest.hawaii.edu/gshhg',
    'ftp://ftp.soest.hawaii.edu/dcw',
]
sources = [
    '%(namelower)s-%(version)s-src.tar.gz',
    'gshhg-%(namelower)s-2.3.7.tar.gz',
    'dcw-%(namelower)s-2.0.0.tar.gz',
]
patches = ['%(name)s-5.1.2_netCDF.patch']
checksums = [
    'ab7062912aeead1021770fad4756e0a99860fde8ea9b428fb00c22fa15a3bbfc',  # %(namelower)s-%(version)s-src.tar.gz
    '9bb1a956fca0718c083bef842e625797535a00ce81f175df08b042c2a92cfe7f',  # gshhg-%(namelower)s-2.3.7.tar.gz
    'd71d209c837a805fed0773c03fadbb26e8c90eb6b68e496ac4a1298c3246cc7a',  # dcw-%(namelower)s-2.0.0.tar.gz
    '2ebe26d55521fba8d0eae48f662611491f7cc0e489833bded11628e9a71f252f',  # %(name)s-5.1.2_netCDF.patch
]

builddependencies = [
    ('CMake', '3.26.3'),
]
dependencies = [
    ('PCRE', '8.45'),
    ('GDAL', '3.7.1'),
    ('netCDF', '4.9.2'),
    ('Ghostscript', '10.01.2'),
    ('cURL', '8.0.1'),
    ('zlib', '1.2.13'),
]

configopts = "-DCOPY_GSHHG=TRUE -DGSHHG_ROOT=%(builddir)s/gshhg-%(namelower)s-2.3.7 -DCOPY_DCW=TRUE -DDCW_ROOT=%(builddir)s/dcw-%(namelower)s-2.0.0 "


sanity_check_paths = {
    'files': ['bin/%(namelower)s', 'bin/isogmt', 'bin/gmtswitch', 'bin/gmt_shell_functions.sh', 'lib64/libgmt.so.%(version)s'],
    'dirs': ['include/%(namelower)s', 'share'],
}

modextrapaths = {'GMTHOME': ''}

moduleclass = 'geo'
